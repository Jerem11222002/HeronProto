# ========================================
# Frontend Configuration
# ========================================

# Local development
REACT_APP_API_URL=http://localhost:5000

# Or production (Vercel frontend + Render backend):
# REACT_APP_API_URL=https://heronproto-2.onrender.com

# ========================================
# Email Service (Required for password reset)
# ========================================

# Resend (Recommended - Free tier available)
# Sign up at https://resend.com and get your API key
RESEND_API_KEY=re_aEUKW3ra_L9Neb7GD4CgWfNRU4PSw3RRv

# ========================================
# Backend Configuration (Render)
# ========================================

# Frontend URL for password reset links
# MUST match your actual frontend domain
FRONTEND_URL=http://localhost:3000
# Or for production:
# FRONTEND_URL=https://heron-proto-c1sn.vercel.app

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_here

# Node environment
NODE_ENV=development

# ========================================
# Database Configuration
# ========================================

MONGODB_URI=your_mongodb_connection_string

# ========================================
# Legacy Email Config (Optional - for backward compatibility)
# ========================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-password

# ========================================
# Testing Emulator Examples (Optional)
# ========================================

# Emulator / device testing examples:
# - Android Studio emulator (use this to reach host localhost from the emulator)
# REACT_APP_API_URL=http://10.0.2.2:5000
#
# - Genymotion emulator:
# REACT_APP_API_URL=http://10.0.3.2:5000
#
# - Physical device on same Wi‑Fi (replace with your machine's LAN IP):
# REACT_APP_API_URL=http://192.168.1.100:5000


