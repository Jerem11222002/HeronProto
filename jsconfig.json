{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["src/*"]
    },
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "target": "ES6",
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*.{js,jsx,ts,tsx}"],
  "exclude": ["node_modules", "build", "dist"]
}