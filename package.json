  "scripts": {
    "start": "react-scripts start",
    "server": "nodemon server.js",
    "client": "react-scripts start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:recommendations": "jest --testPathPattern=recommendations.test.js --verbose",
    "test:recommendations:watch": "jest --testPathPattern=recommendations.test.js --watch",
    "test:recommendations:coverage": "jest --testPathPattern=recommendations.test.js --coverage",
    "audit:database": "node backend/scripts/auditDatabase.js",
    "fix:tags:posts": "node backend/scripts/fixPostTags.js",
    "fix:tags:events": "node backend/scripts/fixEventData.js",
    "fix:all": "npm run audit:database && npm run fix:tags:posts && npm run fix:tags:events",
    "evaluate:recommendations": "node backend/scripts/dynamicRecommendationEvaluator.js",
    "eject": "react-scripts eject",
    "migrate": "node backend/migrations/runMigration.js",
    "migrate:interests": "node backend/migrations/fixInterestsStatus.js",
    "create-admin": "node backend/scripts/createAdmin.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-unused-vars": "off",
      "react-hooks/exhaustive-deps": "off",
      "react/prop-types": "off",
      "no-undef": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "main": "index.js",
  "keywords": [],
